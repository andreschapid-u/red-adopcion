# Credenciales OAuth (nunca las subas al repo).
# Se generan siguiendo el README. En GitHub van como Secrets del repo web.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ID del deployment "API Executable" del Apps Script (no el scriptId).
API_DEPLOYMENT_ID=

# Para desarrollo local sin credenciales: usa fixtures/ en lugar de llamar al API.
# USE_FIXTURES=1
