---
import Base from '../layouts/Base.astro';
import FoundationCard from '../components/FoundationCard.astro';
import { fundaciones, pets, site } from '../lib/data';
import { absUrl, withBase } from '../lib/urls';
import { availablePets, formatNumber, metaDescription } from '../lib/utils';

const disponibles = availablePets(pets);

const counts = new Map<string, number>();
for (const pet of disponibles) {
  counts.set(pet.fundacionId, (counts.get(pet.fundacionId) ?? 0) + 1);
}

const title = 'Fundaciones que rescatan animales | Red de Adopción';
const description = metaDescription(
  `Conoce las ${fundaciones.length} fundaciones y refugios que hacen parte de la red. Suman ${disponibles.length} mascotas en adopción y puedes contactarlas directo por WhatsApp.`,
);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Fundaciones y refugios',
    url: absUrl('/fundaciones/'),
    description,
    inLanguage: 'es-CO',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: absUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Fundaciones', item: absUrl('/fundaciones/') },
    ],
  },
];
---

<Base title={title} description={description} path="/fundaciones/" structuredData={structuredData}>
  <div class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <nav aria-label="Ruta de navegación" class="text-sm text-slate-500">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={withBase('/')} class="hover:text-slate-900">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="font-medium text-slate-700">Fundaciones</li>
        </ol>
      </nav>

      <h1 class="mt-4 text-3xl font-extrabold sm:text-4xl">Fundaciones que rescatan y cuidan</h1>
      <p class="mt-3 max-w-3xl text-lg text-slate-600">
        Cada fundación tiene su propia historia, su equipo y sus protocolos de adopción. Todas comparten
        el mismo compromiso: encontrar familias responsables y acompañar el proceso de principio a fin.
      </p>

      <dl class="mt-8 grid max-w-xl grid-cols-2 gap-3">
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Fundaciones</dt>
          <dd class="mt-1 font-heading text-2xl font-extrabold text-indigo-700">{formatNumber(fundaciones.length)}</dd>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
          <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Mascotas disponibles</dt>
          <dd class="mt-1 font-heading text-2xl font-extrabold text-indigo-700">{formatNumber(disponibles.length)}</dd>
        </div>
      </dl>
    </div>
  </div>

  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    {fundaciones.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {fundaciones.map((fundacion) => (
          <FoundationCard fundacion={fundacion} count={counts.get(fundacion.id) ?? 0} />
        ))}
      </div>
    ) : (
      <p class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center text-slate-500">
        Todavía no hay fundaciones publicadas.
      </p>
    )}

    <div class="mt-12 rounded-3xl border border-indigo-100 bg-indigo-50 p-6 sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="max-w-2xl">
          <h2 class="font-heading text-2xl font-extrabold text-slate-900">¿Haces parte de una fundación?</h2>
          <p class="mt-2 text-slate-600">
            Si rescatas y das en adopción, puedes sumarte a la red para que tus mascotas tengan más
            visibilidad. Escríbenos y revisamos el proceso.
          </p>
        </div>
        {site.general.instagramUrl ? (
          <a
            href={site.general.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700"
          >
            Contactar a la red
          </a>
        ) : (
          <a
            href={withBase('/catalogo/')}
            class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700"
          >
            Ver mascotas
          </a>
        )}
      </div>
    </div>
  </section>
</Base>
