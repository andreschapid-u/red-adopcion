---
import Base from '../layouts/Base.astro';
import PetCard from '../components/PetCard.astro';
import FoundationCard from '../components/FoundationCard.astro';
import { fundaciones, pets, site } from '../lib/data';
import { imageSources } from '../lib/images';
import { absUrl, petPath, withBase } from '../lib/urls';
import { availablePets, formatNumber, metaDescription, sortPets, speciesLabel } from '../lib/utils';

const disponibles = sortPets(availablePets(pets));
const destacados = disponibles.slice(0, 8);
const adoptados = pets.filter((pet) => pet.estado === 'Adoptado').length;
const heroPet = disponibles.find((pet) => pet.fotos.principal) ?? disponibles[0] ?? pets[0];

const heroImage = heroPet ? imageSources(heroPet.fotos.principal) : null;

const counts = new Map<string, number>();
for (const pet of disponibles) {
  counts.set(pet.fundacionId, (counts.get(pet.fundacionId) ?? 0) + 1);
}

const title = 'Mascotas en adopción en Colombia | Red de Adopción';
const description = metaDescription(
  site.general.mision ||
    'Conoce a las mascotas rescatadas por nuestra red de fundaciones y encuentra a tu próximo compañero.',
);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Red de Adopción',
    alternateName: site.general.titulo || undefined,
    url: absUrl('/'),
    description,
    inLanguage: 'es-CO',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'NGO',
    name: 'Red de Adopción',
    url: absUrl('/'),
    sameAs: site.general.instagramUrl ? [site.general.instagramUrl] : undefined,
  },
];
---

<Base title={title} description={description} path="/" structuredData={structuredData}>
  <section class="relative overflow-hidden bg-gradient-to-b from-indigo-50 via-white to-slate-50">
    <div
      class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-indigo-200/40 blur-3xl"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-rose-200/40 blur-3xl"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 py-14 sm:px-6 lg:grid-cols-2 lg:px-8 lg:py-20">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full border border-indigo-100 bg-white px-3 py-1 text-xs font-semibold text-indigo-700 shadow-sm">
          <span class="h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
          {disponibles.length} {disponibles.length === 1 ? 'mascota busca' : 'mascotas buscan'} familia
        </span>

        <h1 class="mt-5 text-4xl font-extrabold leading-[1.1] tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
          Mascotas en adopción que buscan una segunda oportunidad
        </h1>

        <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">
          {site.general.mision ||
            'Rescatamos, cuidamos y buscamos familias responsables para animales que necesitan un nuevo hogar.'}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={withBase('/catalogo/')}
            class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-indigo-200 transition hover:bg-indigo-700"
          >
            Ver mascotas en adopción
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
          <a
            href={withBase('/fundaciones/')}
            class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-6 py-3.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50"
          >
            Conocer las fundaciones
          </a>
        </div>

        <dl class="mt-10 grid max-w-lg grid-cols-3 gap-3">
          <div class="rounded-2xl border border-slate-200 bg-white/80 p-3 text-center shadow-sm">
            <dt class="text-[11px] font-medium uppercase tracking-wide text-slate-500">En adopción</dt>
            <dd class="mt-1 font-heading text-2xl font-extrabold text-indigo-700">{formatNumber(disponibles.length)}</dd>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-white/80 p-3 text-center shadow-sm">
            <dt class="text-[11px] font-medium uppercase tracking-wide text-slate-500">Fundaciones</dt>
            <dd class="mt-1 font-heading text-2xl font-extrabold text-indigo-700">{formatNumber(fundaciones.length)}</dd>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-white/80 p-3 text-center shadow-sm">
            <dt class="text-[11px] font-medium uppercase tracking-wide text-slate-500">Adoptados</dt>
            <dd class="mt-1 font-heading text-2xl font-extrabold text-indigo-700">{formatNumber(adoptados)}</dd>
          </div>
        </dl>
      </div>

      <div class="relative">
        {heroPet && heroImage ? (
          <a
            href={petPath(heroPet.id)}
            class="group block overflow-hidden rounded-[2rem] border border-white bg-white shadow-2xl shadow-indigo-200/50"
          >
            <div class="relative aspect-[4/3] overflow-hidden bg-slate-100 lg:aspect-[4/5]">
              <img
                src={heroImage.src}
                srcset={heroImage.srcset}
                sizes="(min-width: 1024px) 40vw, 100vw"
                width="900"
                height="1100"
                alt={`${heroPet.nombre}, ${speciesLabel(heroPet.especie)} en adopción`}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="h-full w-full object-cover motion-safe:transition motion-safe:duration-500 motion-safe:group-hover:scale-[1.03]"
                onerror="this.onerror=null;this.removeAttribute('srcset');this.src='/red-adopcion/images/pet-placeholder.svg'"
              />
            </div>
            <div class="absolute inset-x-4 bottom-4 rounded-2xl bg-white/95 p-4 shadow-lg backdrop-blur">
              <p class="text-[11px] font-semibold uppercase tracking-wide text-emerald-700">
                {heroPet.estado}
              </p>
              <p class="mt-1 font-heading text-2xl font-extrabold text-slate-900">{heroPet.nombre}</p>
              <p class="text-sm text-slate-600">
                {heroPet.edad} · {heroPet.fundacionNombre}
              </p>
            </div>
          </a>
        ) : (
          <div class="grid aspect-[4/3] place-items-center rounded-[2rem] border border-dashed border-slate-300 bg-white p-8 text-center">
            <div>
              <p class="font-heading text-xl font-bold">Pronto habrá nuevas mascotas</p>
              <p class="mt-2 text-sm text-slate-500">Vuelve en unos días o conoce a las fundaciones.</p>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-indigo-700">Adopción responsable</p>
        <h2 class="mt-2 text-3xl font-extrabold sm:text-4xl">Mascotas que buscan hogar</h2>
        <p class="mt-2 max-w-2xl text-slate-600">
          Cada una tiene una historia, una fundación que la cuida y una familia esperando conocerla.
        </p>
      </div>
      <a href={withBase('/catalogo/')} class="text-sm font-semibold text-indigo-700 hover:text-indigo-900">
        Ver todas ({formatNumber(disponibles.length)}) →
      </a>
    </div>

    {destacados.length > 0 ? (
      <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {destacados.map((pet, index) => (
          <PetCard pet={pet} priority={index < 2} />
        ))}
      </div>
    ) : (
      <p class="mt-8 rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500">
        Todavía no hay mascotas publicadas. Vuelve pronto.
      </p>
    )}
  </section>

  <section class="border-y border-slate-200 bg-white">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 py-14 sm:px-6 lg:grid-cols-3 lg:px-8">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-indigo-700">Cómo funciona</p>
        <h2 class="mt-2 text-3xl font-extrabold">Adoptar en tres pasos</h2>
        <p class="mt-3 text-slate-600">
          No hay carrito ni pagos: hablas directo con la fundación y ella acompaña todo el proceso.
        </p>
      </div>
      <ol class="grid gap-4 sm:grid-cols-3 lg:col-span-2">
        <li class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
          <span class="grid h-9 w-9 place-items-center rounded-full bg-indigo-600 font-heading text-sm font-bold text-white">1</span>
          <h3 class="mt-3 font-heading text-base font-bold">Explora</h3>
          <p class="mt-1 text-sm leading-6 text-slate-600">Filtra por especie, fundación o estado y encuentra una ficha que te conecte.</p>
        </li>
        <li class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
          <span class="grid h-9 w-9 place-items-center rounded-full bg-indigo-600 font-heading text-sm font-bold text-white">2</span>
          <h3 class="mt-3 font-heading text-base font-bold">Conoce</h3>
          <p class="mt-1 text-sm leading-6 text-slate-600">Escribe por WhatsApp a la fundación y agenda una visita o entrevista.</p>
        </li>
        <li class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
          <span class="grid h-9 w-9 place-items-center rounded-full bg-indigo-600 font-heading text-sm font-bold text-white">3</span>
          <h3 class="mt-3 font-heading text-base font-bold">Adopta</h3>
          <p class="mt-1 text-sm leading-6 text-slate-600">Firma el compromiso de adopción y recibe seguimiento de la fundación.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-indigo-700">Red colaborativa</p>
        <h2 class="mt-2 text-3xl font-extrabold sm:text-4xl">Fundaciones aliadas</h2>
      </div>
      <a href={withBase('/fundaciones/')} class="text-sm font-semibold text-indigo-700 hover:text-indigo-900">
        Ver todas →
      </a>
    </div>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {fundaciones.map((fundacion) => (
        <FoundationCard fundacion={fundacion} count={counts.get(fundacion.id) ?? 0} />
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="rounded-3xl bg-indigo-600 px-6 py-10 text-center shadow-xl shadow-indigo-200 sm:px-12">
      <h2 class="font-heading text-3xl font-extrabold text-white">Una adopción cambia dos vidas</h2>
      <p class="mx-auto mt-3 max-w-2xl text-indigo-100">
        Si estás buscando un compañero, empieza por el catálogo. Si conoces a alguien que quiera adoptar,
        comparte una ficha: así llega más lejos.
      </p>
      <a
        href={withBase('/catalogo/')}
        class="mt-6 inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3.5 text-sm font-semibold text-indigo-700 shadow-sm transition hover:bg-indigo-50"
      >
        Encontrar a mi mascota
      </a>
    </div>
  </section>
</Base>
