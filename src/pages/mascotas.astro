---
import Base from '../layouts/Base.astro';
import { pets } from '../lib/data';
import type { Mascota } from '../lib/schema';
import { absUrl, petPath, withBase } from '../lib/urls';
import { formatNumber, initialLetter, metaDescription, sortPets } from '../lib/utils';

const ordenadas = sortPets(pets);

const grupos = new Map<string, Mascota[]>();
for (const pet of ordenadas) {
  const letter = initialLetter(pet.nombre);
  const list = grupos.get(letter) ?? [];
  list.push(pet);
  grupos.set(letter, list);
}

const letras = [...grupos.keys()].sort((a, b) => {
  if (a === '#') return 1;
  if (b === '#') return -1;
  return a.localeCompare(b, 'es');
});

const anchor = (letter: string): string => `letra-${letter === '#' ? 'otros' : letter}`;

const title = `Todas las mascotas (${formatNumber(pets.length)}) | Red de Adopción`;
const description = metaDescription(
  `Índice alfabético de las ${pets.length} mascotas de la red: perros, gatos y otros animales rescatados que buscan familia o que ya fueron adoptados.`,
);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Índice de mascotas',
    url: absUrl('/mascotas/'),
    description,
    inLanguage: 'es-CO',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: absUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Mascotas', item: absUrl('/mascotas/') },
    ],
  },
];
---

<Base title={title} description={description} path="/mascotas/" structuredData={structuredData}>
  <div class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <nav aria-label="Ruta de navegación" class="text-sm text-slate-500">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={withBase('/')} class="hover:text-slate-900">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="font-medium text-slate-700">Mascotas</li>
        </ol>
      </nav>

      <h1 class="mt-4 text-3xl font-extrabold sm:text-4xl">Todas las mascotas</h1>
      <p class="mt-3 max-w-3xl text-lg text-slate-600">
        {formatNumber(pets.length)} fichas publicadas por las fundaciones de la red. Usa el índice para
        llegar rápido a una mascota o vuelve al
        <a class="font-semibold text-indigo-700 hover:text-indigo-900" href={withBase('/catalogo/')}>
          catálogo con filtros
        </a>.
      </p>

      <nav aria-label="Índice alfabético" class="mt-6 flex flex-wrap gap-2">
        {letras.map((letter) => (
          <a
            href={`#${anchor(letter)}`}
            class="grid h-9 min-w-9 place-items-center rounded-lg border border-slate-200 bg-white px-2 text-sm font-semibold text-slate-700 transition hover:border-indigo-300 hover:text-indigo-700"
          >
            {letter}
          </a>
        ))}
      </nav>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    {letras.map((letter) => (
      <section id={anchor(letter)} class="scroll-mt-24 border-b border-slate-200 py-6 first:pt-0 last:border-0">
        <h2 class="font-heading text-2xl font-extrabold text-indigo-700">{letter}</h2>
        <ul class="mt-4 grid gap-x-6 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
          {grupos.get(letter)?.map((pet) => (
            <li>
              <a
                href={petPath(pet.id)}
                class="flex items-baseline justify-between gap-3 rounded-lg px-2 py-1.5 transition hover:bg-white"
              >
                <span class="min-w-0">
                  <span class="block truncate text-sm font-semibold text-slate-800">{pet.nombre}</span>
                  <span class="block truncate text-xs text-slate-500">{pet.fundacionNombre}</span>
                </span>
                <span
                  class:list={[
                    'shrink-0 text-[11px] font-medium',
                    pet.estado === 'Disponible en adopción'
                      ? 'text-emerald-700'
                      : pet.estado === 'Adoptado'
                        ? 'text-indigo-600'
                        : 'text-slate-400',
                  ]}
                >
                  {pet.estado}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {pets.length === 0 && (
      <p class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center text-slate-500">
        Todavía no hay mascotas publicadas.
      </p>
    )}
  </div>
</Base>
