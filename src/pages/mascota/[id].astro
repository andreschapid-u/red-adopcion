---
import type { Mascota } from '../../lib/schema';
import Base from '../../layouts/Base.astro';
import PetCard from '../../components/PetCard.astro';
import ShareDialog from '../../components/ShareDialog.astro';
import { fundacionesPorId, pets } from '../../lib/data';
import { imageSources, ogImage } from '../../lib/images';
import { absUrl, asset, petAbsUrl, withBase } from '../../lib/urls';
import {
  ESTADO_DISPONIBLE,
  WHATSAPP_TEXT,
  availablePets,
  metaDescription,
  petSummary,
  sortPets,
  speciesLabel,
  whatsappUrl,
} from '../../lib/utils';

export function getStaticPaths() {
  return pets.map((pet) => ({ params: { id: pet.id }, props: { pet } }));
}

interface Props {
  pet: Mascota;
}

const { pet } = Astro.props;
const fundacion = fundacionesPorId.get(pet.fundacionId);

const image = imageSources(pet.fotos.principal);
const imageSrc = asset(image.src);
const placeholder = asset('/images/pet-placeholder.svg');
const fallback = `this.onerror=null;this.removeAttribute('srcset');this.src='${placeholder}'`;

const antes = pet.fotos.antes ? imageSources(pet.fotos.antes) : null;
const despues = pet.fotos.despues ? imageSources(pet.fotos.despues) : null;

const summary = petSummary(pet);
const description = metaDescription(
  `${pet.nombre} (${pet.especie}, ${pet.edad}) busca hogar en ${pet.fundacionNombre}. ${summary}`,
);
const title = `${pet.nombre} busca hogar en ${pet.fundacionNombre} | Red de Adopción`;
const canonical = petAbsUrl(pet.id);
const og = ogImage(pet.fotos.principal);

const adoptar =
  pet.estado === ESTADO_DISPONIBLE && fundacion
    ? whatsappUrl(fundacion.whatsapp, WHATSAPP_TEXT(pet))
    : '';

const donar = fundacion
  ? whatsappUrl(
      fundacion.whatsapp,
      `Hola ${fundacion.nombre}, quiero apoyar con una donación el cuidado de sus rescatados.`,
    )
  : '';

const shareText = `Conoce a ${pet.nombre}, ${speciesLabel(pet.especie)} en adopción en ${pet.fundacionNombre} 🐾`;

const related = sortPets(
  availablePets(pets).filter(
    (candidate) => candidate.fundacionId === pet.fundacionId && candidate.id !== pet.id,
  ),
).slice(0, 4);

const estadoClass =
  pet.estado === 'Disponible en adopción'
    ? 'bg-emerald-50 text-emerald-700 ring-emerald-600/20'
    : pet.estado === 'Adoptado'
      ? 'bg-indigo-50 text-indigo-700 ring-indigo-600/20'
      : 'bg-slate-100 text-slate-600 ring-slate-500/20';

const logo = fundacion?.logo ? imageSources(fundacion.logo) : null;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: absUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Catálogo', item: absUrl('/catalogo/') },
      { '@type': 'ListItem', position: 3, name: pet.nombre, item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: canonical,
    inLanguage: 'es-CO',
    primaryImageOfPage: og,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Pet',
    name: pet.nombre,
    url: canonical,
    image: og,
    description: summary,
    species: speciesLabel(pet.especie),
    ...(fundacion
      ? {
          owner: {
            '@type': 'NGO',
            name: fundacion.nombre,
            url: fundacion.redesUrl || undefined,
          },
        }
      : {}),
  },
];
---

<Base
  title={title}
  description={description}
  path={`/mascota/${pet.id}/`}
  image={og}
  type="article"
  structuredData={structuredData}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <nav aria-label="Ruta de navegación" class="text-sm text-slate-500">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href={withBase('/')} class="hover:text-slate-900">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={withBase('/catalogo/')} class="hover:text-slate-900">Catálogo</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-medium text-slate-700">{pet.nombre}</li>
      </ol>
    </nav>

    <header class="mt-5 max-w-3xl">
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-semibold text-indigo-700 ring-1 ring-inset ring-indigo-600/20">
          {pet.especie}
        </span>
        <span class:list={['rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset', estadoClass]}>
          {pet.estado}
        </span>
        <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">{pet.edad}</span>
      </div>

      <h1 class="mt-3 text-4xl font-extrabold tracking-tight sm:text-5xl">{pet.nombre}</h1>
      <p class="mt-3 text-lg leading-8 text-slate-600">
        {summary}
      </p>
      {fundacion && (
        <p class="mt-3 text-sm text-slate-500">
          Al cuidado de
          <a
            href={`${withBase('/catalogo/')}?fundacion=${encodeURIComponent(fundacion.id)}`}
            class="font-semibold text-indigo-700 hover:text-indigo-900"
          >
            {fundacion.nombre}
          </a>
        </p>
      )}
    </header>

    <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
      <div>
        <figure class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
          <div class="aspect-[4/3] overflow-hidden bg-slate-100">
            <img
              src={imageSrc}
              srcset={image.srcset}
              sizes="(min-width: 1024px) 60vw, 100vw"
              width="1200"
              height="900"
              alt={`${pet.nombre}, ${speciesLabel(pet.especie)} — ${pet.estado}`}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="h-full w-full object-cover"
              onerror={fallback}
            />
          </div>
        </figure>

        {(antes || despues) && (
          <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
            <h2 class="font-heading text-xl font-bold">Su transformación</h2>
            <p class="mt-1 text-sm text-slate-500">El antes y el después de su rescate, contado en imágenes.</p>
            <div class:list={['mt-4 grid gap-4', antes && despues ? 'sm:grid-cols-2' : '']}>
              {antes && (
                <figure>
                  <div class="aspect-[4/3] overflow-hidden rounded-xl bg-slate-100">
                    <img
                      src={asset(antes.src)}
                      srcset={antes.srcset}
                      sizes="(min-width: 640px) 30vw, 100vw"
                      width="800"
                      height="600"
                      alt={`${pet.nombre} antes del rescate`}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover"
                      onerror={fallback}
                    />
                  </div>
                  <figcaption class="mt-2 text-xs font-semibold uppercase tracking-wide text-slate-500">
                    Antes del rescate
                  </figcaption>
                </figure>
              )}
              {despues && (
                <figure>
                  <div class="aspect-[4/3] overflow-hidden rounded-xl bg-slate-100">
                    <img
                      src={asset(despues.src)}
                      srcset={despues.srcset}
                      sizes="(min-width: 640px) 30vw, 100vw"
                      width="800"
                      height="600"
                      alt={`${pet.nombre} después de su recuperación`}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover"
                      onerror={fallback}
                    />
                  </div>
                  <figcaption class="mt-2 text-xs font-semibold uppercase tracking-wide text-emerald-700">
                    Después de su recuperación
                  </figcaption>
                </figure>
              )}
            </div>
          </section>
        )}

        <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6">
          <h2 class="font-heading text-xl font-bold">Sobre {pet.nombre}</h2>
          <p class="pet-description mt-3">
            {pet.descripcion || pet.cualidades || summary}
          </p>

          <dl class="mt-6 grid gap-4 border-t border-slate-100 pt-5 sm:grid-cols-3">
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Especie</dt>
              <dd class="mt-1 text-sm font-medium text-slate-800">{pet.especie}</dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Edad</dt>
              <dd class="mt-1 text-sm font-medium text-slate-800">{pet.edad || 'Sin dato'}</dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Estado</dt>
              <dd class="mt-1 text-sm font-medium text-slate-800">{pet.estado}</dd>
            </div>
          </dl>
        </section>
      </div>

      <aside class="space-y-5">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="font-heading text-xl font-extrabold">
            {pet.estado === ESTADO_DISPONIBLE
              ? `¿Quieres adoptar a ${pet.nombre}?`
              : pet.estado === 'Adoptado'
                ? `${pet.nombre} ya encontró familia`
                : `En memoria de ${pet.nombre}`}
          </h2>

          {pet.estado === ESTADO_DISPONIBLE ? (
            <>
              <p class="mt-2 text-sm leading-6 text-slate-600">
                Escribe directamente a la fundación. Te contarán cómo es el proceso, qué documentos
                piden y cómo es el seguimiento de la adopción.
              </p>
              {adoptar ? (
                <a
                  href={adoptar}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-4 flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700"
                >
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 4h3l1.5 4-2 1.5a11 11 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2Z" />
                  </svg>
                  Hablar por WhatsApp
                </a>
              ) : (
                <p class="mt-3 rounded-lg bg-amber-50 p-3 text-sm text-amber-800">
                  La fundación no tiene un número de WhatsApp público. Puedes escribirle por sus redes.
                </p>
              )}
            </>
          ) : (
            <p class="mt-2 text-sm leading-6 text-slate-600">
              {pet.estado === 'Adoptado'
                ? 'Esta ficha se conserva para recordar su historia. Si quieres adoptar, revisa las mascotas disponibles en el catálogo.'
                : 'Esta ficha se conserva como memoria de su paso por la red. Gracias a quienes lo cuidaron.'}
            </p>
          )}

          {pet.estado === ESTADO_DISPONIBLE && donar && (
            <a
              href={donar}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-2 flex w-full items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
            >
              Hacer una donación
            </a>
          )}

          <div class="mt-4 border-t border-slate-100 pt-4">
            <ShareDialog url={canonical} title={pet.nombre} text={shareText} />
          </div>

          <p class="mt-3 text-xs leading-5 text-slate-500">
            La adopción se acuerda directamente con la fundación. No pedimos dinero ni datos por fuera
            de sus canales oficiales.
          </p>
        </div>

        {fundacion && (
          <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <div class="flex items-center gap-3">
              <div class="relative grid h-12 w-12 shrink-0 place-items-center overflow-hidden rounded-xl bg-indigo-50 font-heading text-lg font-bold text-indigo-700">
                <span aria-hidden="true">{fundacion.nombre.charAt(0).toUpperCase()}</span>
                {logo && (
                  <img
                    src={asset(logo.src)}
                    srcset={logo.srcset}
                    sizes="48px"
                    width="48"
                    height="48"
                    alt={`Logo de ${fundacion.nombre}`}
                    loading="lazy"
                    decoding="async"
                    class="absolute inset-0 h-full w-full bg-white object-contain p-1"
                    onerror="this.style.display='none'"
                  />
                )}
              </div>
              <div class="min-w-0">
                <h2 class="font-heading text-base font-bold leading-tight">{fundacion.nombre}</h2>
                <p class="mt-0.5 text-xs text-slate-500">Fundación aliada</p>
              </div>
            </div>

            <div class="mt-4 flex flex-wrap gap-2">
              <a
                href={`${withBase('/catalogo/')}?fundacion=${encodeURIComponent(fundacion.id)}`}
                class="rounded-lg bg-slate-900 px-3 py-2 text-xs font-semibold text-white transition hover:bg-slate-700"
              >
                Ver sus mascotas
              </a>
              {fundacion.redesUrl && (
                <a
                  href={fundacion.redesUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-600 transition hover:bg-slate-50"
                >
                  Redes sociales
                </a>
              )}
            </div>
          </div>
        )}
      </aside>
    </div>

    {related.length > 0 && (
      <section class="mt-14">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-indigo-700">Misma fundación</p>
            <h2 class="mt-1 text-2xl font-extrabold sm:text-3xl">Otras mascotas que buscan hogar</h2>
          </div>
          <a
            href={`${withBase('/catalogo/')}?fundacion=${encodeURIComponent(pet.fundacionId)}`}
            class="text-sm font-semibold text-indigo-700 hover:text-indigo-900"
          >
            Ver todas →
          </a>
        </div>
        <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {related.map((candidate) => (
            <PetCard pet={candidate} />
          ))}
        </div>
      </section>
    )}
  </div>
</Base>
