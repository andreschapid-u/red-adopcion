---
import type { PosterData } from '../lib/share-card';
import { jsonLd } from '../lib/utils';

interface Props {
  url: string;
  title: string;
  text: string;
  poster: PosterData;
}

const { url, title, text, poster } = Astro.props;
const enc = encodeURIComponent;

const facebook = `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`;
const whatsapp = `https://wa.me/?text=${enc(`${text} ${url}`)}`;
const x = `https://twitter.com/intent/tweet?url=${enc(url)}&text=${enc(text)}`;
---

<button
  type="button"
  data-share-open
  class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50"
>
  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="18" cy="5" r="3" />
    <circle cx="6" cy="12" r="3" />
    <circle cx="18" cy="19" r="3" />
    <path d="m8.6 10.5 6.8-4M8.6 13.5l6.8 4" />
  </svg>
  Compartir ficha
</button>

<dialog
  id="share-dialog"
  class="m-auto max-h-[92vh] w-[calc(100%-2rem)] max-w-md overscroll-contain overflow-y-auto rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-900/50"
  data-url={url}
  data-title={title}
  data-text={text}
  aria-labelledby="share-heading"
>
  <script is:inline type="application/json" data-poster-data set:html={jsonLd(poster)} />

  <div class="p-5 sm:p-6">
    <div class="flex items-start justify-between gap-3">
      <div>
        <h2 id="share-heading" class="font-heading text-lg font-bold">Comparte esta ficha</h2>
        <p class="mt-1 text-sm text-slate-500">Ayuda a que {title} encuentre familia.</p>
      </div>
      <button
        type="button"
        data-share-close
        class="grid h-8 w-8 place-items-center rounded-lg text-slate-500 transition hover:bg-slate-100"
        aria-label="Cerrar"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>

    <div role="tablist" aria-label="Forma de compartir" class="mt-4 grid grid-cols-2 gap-1 rounded-xl bg-slate-100 p-1">
      <button
        type="button"
        role="tab"
        id="share-tab-enlace"
        data-tab="enlace"
        aria-selected="true"
        aria-controls="share-panel-enlace"
        class="rounded-lg px-3 py-2 text-sm font-semibold text-slate-500 transition aria-selected:bg-white aria-selected:text-indigo-700 aria-selected:shadow-sm"
      >
        Enlace
      </button>
      <button
        type="button"
        role="tab"
        id="share-tab-imagen"
        data-tab="imagen"
        aria-selected="false"
        aria-controls="share-panel-imagen"
        class="rounded-lg px-3 py-2 text-sm font-semibold text-slate-500 transition aria-selected:bg-white aria-selected:text-indigo-700 aria-selected:shadow-sm"
      >
        Imagen
      </button>
    </div>

    <div id="share-panel-enlace" data-panel="enlace" role="tabpanel" aria-labelledby="share-tab-enlace">
      <div class="mt-4 grid grid-cols-2 gap-2">
        <a
          href={facebook}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 rounded-xl border border-slate-200 px-3 py-2.5 text-sm font-medium transition hover:bg-slate-50"
        >
          <span class="grid h-8 w-8 place-items-center rounded-full bg-[#1877f2] text-sm font-bold text-white" aria-hidden="true">f</span>
          Facebook
        </a>

        <a
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 rounded-xl border border-slate-200 px-3 py-2.5 text-sm font-medium transition hover:bg-slate-50"
        >
          <span class="grid h-8 w-8 place-items-center rounded-full bg-[#25d366] text-white" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 4h3l1.5 4-2 1.5a11 11 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2Z" />
            </svg>
          </span>
          WhatsApp
        </a>

        <a
          href={x}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 rounded-xl border border-slate-200 px-3 py-2.5 text-sm font-medium transition hover:bg-slate-50"
        >
          <span class="grid h-8 w-8 place-items-center rounded-full bg-slate-900 text-sm font-bold text-white" aria-hidden="true">X</span>
          X (Twitter)
        </a>

        <button
          type="button"
          data-share-instagram
          class="flex items-center gap-2 rounded-xl border border-slate-200 px-3 py-2.5 text-left text-sm font-medium transition hover:bg-slate-50"
        >
          <span class="grid h-8 w-8 place-items-center rounded-full bg-gradient-to-br from-amber-400 via-pink-500 to-purple-600 text-white" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
            </svg>
          </span>
          Instagram
        </button>

        <button
          type="button"
          data-share-copy
          class="flex items-center gap-2 rounded-xl border border-slate-200 px-3 py-2.5 text-left text-sm font-medium transition hover:bg-slate-50"
        >
          <span class="grid h-8 w-8 place-items-center rounded-full bg-slate-100 text-slate-600" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" d="M10 13a5 5 0 0 0 7 0l2-2a5 5 0 0 0-7-7l-1 1" />
              <path stroke-linecap="round" d="M14 11a5 5 0 0 0-7 0l-2 2a5 5 0 0 0 7 7l1-1" />
            </svg>
          </span>
          Copiar enlace
        </button>

        <button
          type="button"
          data-share-native
          hidden
          class="flex items-center gap-2 rounded-xl border border-slate-200 px-3 py-2.5 text-left text-sm font-medium transition hover:bg-slate-50"
        >
          <span class="grid h-8 w-8 place-items-center rounded-full bg-indigo-100 text-indigo-700" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="5" r="2.5" />
              <circle cx="5" cy="17" r="2.5" />
              <circle cx="19" cy="17" r="2.5" />
              <path d="m10.7 7.1-4.4 7.8M13.3 7.1l4.4 7.8M7.5 17h9" />
            </svg>
          </span>
          Más opciones
        </button>
      </div>

      <p class="mt-4 rounded-lg bg-slate-50 px-3 py-2 text-xs leading-5 text-slate-500">
        Instagram no permite compartir enlaces desde el navegador: copiamos el enlace para que lo pegues en tu historia o usa “Más opciones” en el celular. Para una historia o un estado, elige la pestaña <strong>Imagen</strong>.
      </p>
    </div>

    <div id="share-panel-imagen" data-panel="imagen" role="tabpanel" aria-labelledby="share-tab-imagen" hidden>
      <div class="relative mx-auto mt-4 w-full max-w-[240px]">
        <canvas
          data-poster-preview
          width="540"
          height="960"
          tabindex="0"
          role="application"
          aria-label="Vista previa del póster. Arrastra la foto o usa las flechas del teclado para centrar al animal."
          class="block h-auto w-full cursor-grab touch-none select-none rounded-xl bg-slate-900 shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
        ></canvas>
        <p class="pointer-events-none absolute bottom-3 left-1/2 w-max -translate-x-1/2 whitespace-nowrap rounded-full bg-slate-900/75 px-3 py-1 text-[10px] font-semibold text-white">
          Arrastra para centrar
        </p>
      </div>

      <div class="mt-3 flex gap-2">
        <button
          type="button"
          data-poster-reset
          class="flex-1 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
        >
          Centrar
        </button>
        <button
          type="button"
          data-poster-download
          class="flex-1 rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
        >
          Descargar imagen
        </button>
      </div>

      <button
        type="button"
        data-poster-share
        class="mt-2 w-full rounded-xl bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 disabled:cursor-wait disabled:opacity-70"
      >
        Finalizar y compartir
      </button>

      <p class="mt-2 text-center text-xs leading-5 text-slate-500">
        La imagen de 1080×1920 incluye el nombre, los datos y la URL. En el celular se abre la hoja del sistema para elegir WhatsApp, Instagram o Facebook.
      </p>
    </div>

    <p data-share-status role="status" aria-live="polite" class="mt-2 min-h-5 text-sm font-medium text-emerald-700"></p>
  </div>
</dialog>

<script>
  import {
    POSTER_WIDTH,
    coverRect,
    defaultFocus,
    drawPoster,
    loadPosterImage,
    renderPosterBlob,
    PHOTO_HEIGHT,
    type Focus,
    type LoadedImage,
    type PosterData,
  } from '../lib/share-card';

  const dialog = document.getElementById('share-dialog') as HTMLDialogElement | null;

  if (dialog) {
    const url = dialog.dataset.url || location.href;
    const title = dialog.dataset.title || document.title;
    const text = dialog.dataset.text || title;
    const status = dialog.querySelector<HTMLElement>('[data-share-status]');
    const dataNode = dialog.querySelector<HTMLScriptElement>('[data-poster-data]');

    let poster: PosterData | null = null;
    try {
      poster = dataNode?.textContent ? (JSON.parse(dataNode.textContent) as PosterData) : null;
    } catch {
      poster = null;
    }

    const preview = dialog.querySelector<HTMLCanvasElement>('[data-poster-preview]');
    const shareButton = dialog.querySelector<HTMLButtonElement>('[data-poster-share]');
    const downloadButton = dialog.querySelector<HTMLButtonElement>('[data-poster-download]');
    const resetButton = dialog.querySelector<HTMLButtonElement>('[data-poster-reset]');

    let statusTimer: number | undefined;
    const setStatus = (message: string): void => {
      if (!status) return;
      status.textContent = message;
      window.clearTimeout(statusTimer);
      statusTimer = window.setTimeout(() => {
        status.textContent = '';
      }, 6000);
    };

    const copy = async (value: string): Promise<boolean> => {
      try {
        await navigator.clipboard.writeText(value);
        return true;
      } catch {
        const area = document.createElement('textarea');
        area.value = value;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.appendChild(area);
        area.select();
        let ok = false;
        try {
          ok = document.execCommand('copy');
        } catch {
          ok = false;
        }
        document.body.removeChild(area);
        return ok;
      }
    };

    document.querySelectorAll('[data-share-open]').forEach((button) => {
      button.addEventListener('click', () => dialog.showModal());
    });

    dialog.querySelector('[data-share-close]')?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.querySelector('[data-share-copy]')?.addEventListener('click', async () => {
      const ok = await copy(url);
      setStatus(ok ? 'Enlace copiado al portapapeles.' : 'No se pudo copiar. Selecciona el enlace manualmente.');
    });

    dialog.querySelector('[data-share-instagram]')?.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({ title, text, url });
          setStatus('Compartido.');
          return;
        } catch {
          // El usuario canceló o la app no lo permitió: seguimos con copiar.
        }
      }
      window.open('https://www.instagram.com/', '_blank', 'noopener');
      const ok = await copy(`${text} ${url}`);
      setStatus(ok ? 'Enlace copiado. Pégalo en tu historia de Instagram.' : 'Abre Instagram y pega el enlace.');
    });

    const nativeButton = dialog.querySelector<HTMLButtonElement>('[data-share-native]');
    if (nativeButton) {
      if (navigator.share) {
        nativeButton.hidden = false;
        nativeButton.addEventListener('click', async () => {
          try {
            await navigator.share({ title, text, url });
          } catch {
            // Cancelado por el usuario.
          }
        });
      } else {
        nativeButton.hidden = true;
      }
    }

    if (poster && preview && shareButton) {
      const ctx = preview.getContext('2d');
      const scale = preview.width / POSTER_WIDTH;

      let loaded: LoadedImage | null = null;
      let imageTried = false;
      let baseFocus: Focus = { x: 0.5, y: 0.5 };
      let focus: Focus = { ...baseFocus };
      let blob: Blob | null = null;
      let pending: Promise<void> | null = null;
      let token = 0;
      let timer: number | undefined;
      let stale = false;
      let prepared = false;
      let drag: { id: number; x: number; y: number; focus: Focus } | null = null;

      const clamp01 = (value: number): number => Math.min(1, Math.max(0, value));

      const drawPreview = (): void => {
        if (!ctx || !poster) return;
        drawPoster(ctx, loaded, poster, focus, scale);
      };

      const ensureImage = async (): Promise<void> => {
        if (imageTried || !poster) return;
        imageTried = true;
        await Promise.all([
          document.fonts.load('800 128px "Montserrat Variable"'),
          document.fonts.load('700 28px "Inter Variable"'),
          document.fonts.load('500 34px "Inter Variable"'),
          document.fonts.load('400 44px "Inter Variable"'),
        ]).catch(() => undefined);
        loaded = await loadPosterImage(poster.foto);
        if (loaded) {
          baseFocus = defaultFocus(loaded.width, loaded.height);
          focus = { ...baseFocus };
        }
      };

      const generate = (): void => {
        if (!poster) return;
        const snapshot = { ...focus };
        const current = ++token;
        pending = (async () => {
          await ensureImage();
          try {
            const next = await renderPosterBlob(loaded, poster, snapshot);
            if (current === token) blob = next;
          } catch {
            // Conserva el blob anterior si falla una regeneración.
          } finally {
            if (current === token) pending = null;
          }
        })();
      };

      const schedule = (): void => {
        stale = true;
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          stale = false;
          generate();
        }, 150);
      };

      const ensureBlob = async (): Promise<Blob | null> => {
        window.clearTimeout(timer);
        if (stale || !blob) {
          stale = false;
          generate();
        }
        await pending;
        return blob;
      };

      const filename = (): string => {
        const slug = (poster?.nombre || 'mascota')
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '');
        return `red-adopcion-${slug || 'mascota'}.jpg`;
      };

      const download = (file: Blob): void => {
        const anchor = document.createElement('a');
        anchor.href = URL.createObjectURL(file);
        anchor.download = filename();
        document.body.appendChild(anchor);
        anchor.click();
        anchor.remove();
        window.setTimeout(() => URL.revokeObjectURL(anchor.href), 1000);
      };

      const prepare = async (): Promise<void> => {
        if (!poster) return;
        if (!prepared) {
          prepared = true;
          await ensureImage();
          drawPreview();
        }
        if (!blob) generate();
      };

      const shareOrDownload = async (current: Blob): Promise<void> => {
        const file = new File([current], filename(), { type: 'image/jpeg' });
        const payload: ShareData = { files: [file], title, text };
        const canNative =
          typeof navigator.share === 'function' &&
          (!navigator.canShare || navigator.canShare(payload));

        if (canNative) {
          try {
            // Llamada síncrona al gesto cuando el blob ya existe (iOS).
            await navigator.share(payload);
            setStatus('Imagen compartida.');
            return;
          } catch (error) {
            if (error instanceof DOMException && error.name === 'AbortError') return;
          }
        }

        download(current);
        setStatus('Imagen descargada. Adjúntala en tu historia o estado.');
      };

      shareButton.addEventListener('click', async () => {
        if (!poster) return;

        // Con el blob listo, compartimos sin await previo para conservar el gesto.
        if (blob && !stale) {
          void shareOrDownload(blob);
          return;
        }

        const label = shareButton.textContent;
        shareButton.disabled = true;
        shareButton.textContent = 'Preparando imagen…';
        const current = await ensureBlob();
        shareButton.disabled = false;
        shareButton.textContent = label;

        if (!current) {
          setStatus('No se pudo generar la imagen. Intenta de nuevo.');
          return;
        }

        await shareOrDownload(current);
      });

      downloadButton?.addEventListener('click', async () => {
        const current = await ensureBlob();
        if (!current) {
          setStatus('No se pudo generar la imagen.');
          return;
        }
        download(current);
        setStatus('Imagen descargada.');
      });

      resetButton?.addEventListener('click', () => {
        focus = { ...baseFocus };
        drawPreview();
        schedule();
      });

      preview.addEventListener('pointerdown', (event) => {
        if (!loaded) return;
        preview.setPointerCapture(event.pointerId);
        drag = {
          id: event.pointerId,
          x: event.clientX,
          y: event.clientY,
          focus: { ...focus },
        };
        preview.classList.add('cursor-grabbing');
      });

      preview.addEventListener('pointermove', (event) => {
        if (!drag || drag.id !== event.pointerId || !loaded) return;
        const rect = preview.getBoundingClientRect();
        if (!rect.width) return;

        const factor = preview.width / rect.width;
        const dx = (event.clientX - drag.x) * factor;
        const dy = (event.clientY - drag.y) * factor;
        const overflow = coverRect(loaded.width, loaded.height, POSTER_WIDTH, PHOTO_HEIGHT, {
          x: 0.5,
          y: 0.5,
        });
        const overflowX = overflow.overflowX * scale;
        const overflowY = overflow.overflowY * scale;

        focus = {
          x: overflowX > 0 ? clamp01(drag.focus.x - dx / overflowX) : drag.focus.x,
          y: overflowY > 0 ? clamp01(drag.focus.y - dy / overflowY) : drag.focus.y,
        };
        drawPreview();
      });

      const endDrag = (event: PointerEvent): void => {
        if (!drag || drag.id !== event.pointerId) return;
        drag = null;
        preview.classList.remove('cursor-grabbing');
        schedule();
      };

      preview.addEventListener('pointerup', endDrag);
      preview.addEventListener('pointercancel', endDrag);

      preview.addEventListener('keydown', (event) => {
        const step = event.shiftKey ? 0.1 : 0.04;
        let dx = 0;
        let dy = 0;
        if (event.key === 'ArrowLeft') dx = step;
        else if (event.key === 'ArrowRight') dx = -step;
        else if (event.key === 'ArrowUp') dy = step;
        else if (event.key === 'ArrowDown') dy = -step;
        else return;

        event.preventDefault();
        focus = { x: clamp01(focus.x + dx), y: clamp01(focus.y + dy) };
        drawPreview();
        schedule();
      });

      const tabs = dialog.querySelectorAll<HTMLButtonElement>('[data-tab]');
      const panels = dialog.querySelectorAll<HTMLElement>('[data-panel]');

      const selectTab = (name: string): void => {
        tabs.forEach((tab) => {
          tab.setAttribute('aria-selected', String(tab.dataset.tab === name));
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.panel !== name;
        });
        if (name === 'imagen') void prepare();
      };

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => selectTab(tab.dataset.tab || 'enlace'));
      });
    }
  }
</script>
