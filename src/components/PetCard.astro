---
import type { Estado, Mascota } from '../lib/schema';
import { imageSources } from '../lib/images';
import { asset, petPath } from '../lib/urls';
import { CARD_SIZES, petSummary, speciesLabel } from '../lib/utils';

interface Props {
  pet: Mascota;
  /** true en las tarjetas visibles al cargar (mejora el LCP). */
  priority?: boolean;
}

const { pet, priority = false } = Astro.props;

const image = imageSources(pet.fotos.principal);
const src = asset(image.src);
const placeholder = asset('/images/pet-placeholder.svg');
const fallback = `this.onerror=null;this.removeAttribute('srcset');this.src='${placeholder}'`;

const estadoClass: Record<Estado, string> = {
  'Disponible en adopción': 'bg-emerald-50 text-emerald-700 ring-emerald-600/20',
  Adoptado: 'bg-indigo-50 text-indigo-700 ring-indigo-600/20',
  Fallecido: 'bg-slate-100 text-slate-600 ring-slate-500/20',
};
---

<article class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/60">
  <a href={petPath(pet.id)} class="block focus-visible:rounded-2xl">
    <div class="relative aspect-[4/3] overflow-hidden bg-slate-100">
      <img
        src={src}
        srcset={image.srcset}
        sizes={CARD_SIZES}
        width="640"
        height="480"
        alt={`${pet.nombre}, ${speciesLabel(pet.especie)} — ${pet.estado}`}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
        class="h-full w-full object-cover motion-safe:transition motion-safe:duration-300 motion-safe:group-hover:scale-105"
        onerror={fallback}
      />
      <span
        class:list={[
          'absolute left-3 top-3 rounded-full px-2.5 py-1 text-[11px] font-semibold ring-1 ring-inset',
          estadoClass[pet.estado],
        ]}
      >
        {pet.estado}
      </span>
    </div>

    <div class="p-4">
      <div class="flex items-baseline justify-between gap-2">
        <h3 class="font-heading text-lg font-bold leading-tight text-slate-900">{pet.nombre}</h3>
        <span class="shrink-0 text-xs font-medium text-slate-500">{pet.edad}</span>
      </div>
      <p class="mt-1 text-sm font-medium text-indigo-700">{pet.fundacionNombre}</p>
      <p class="mt-2 line-clamp-2 min-h-[2.5rem] text-sm leading-5 text-slate-600">
        {petSummary(pet)}
      </p>
      <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-indigo-700">
        Conocer a {pet.nombre}
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </span>
    </div>
  </a>
</article>
