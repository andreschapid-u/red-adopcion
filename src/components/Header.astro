---
import { withBase } from '../lib/urls';

const path = Astro.url.pathname;

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/catalogo/', label: 'Catálogo' },
  { href: '/fundaciones/', label: 'Fundaciones' },
  { href: '/mascotas/', label: 'Todas las mascotas' },
];

function isActive(href: string): boolean {
  if (href === '/') return path === import.meta.env.BASE_URL;
  if (href === '/catalogo/') return path.startsWith(withBase('/catalogo/')) || path.includes('/mascota/');
  return path.startsWith(withBase(href));
}

const linkClass = (href: string) =>
  isActive(href)
    ? 'text-indigo-700 font-semibold'
    : 'text-slate-600 hover:text-indigo-700';
---

<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href={withBase('/')} class="flex items-center gap-2.5" aria-label="Red de Adopción — inicio">
      <span class="grid h-9 w-9 place-items-center rounded-xl bg-indigo-600 text-white shadow-sm">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
          <ellipse cx="6.7" cy="9.2" rx="2" ry="2.6" />
          <ellipse cx="12" cy="7.2" rx="2" ry="2.6" />
          <ellipse cx="17.3" cy="9.2" rx="2" ry="2.6" />
          <path d="M12 11.8c-2.9 0-5.1 2.1-5.1 4.7 0 1.8 1.3 3 3 3 .8 0 1.4-.3 2.1-.3s1.3.3 2.1.3c1.7 0 3-1.2 3-3 0-2.6-2.2-4.7-5.1-4.7z" />
        </svg>
      </span>
      <span class="font-heading text-lg font-extrabold tracking-tight text-slate-900">
        Red de Adopción
      </span>
    </a>

    <nav class="hidden items-center gap-7 text-sm lg:flex" aria-label="Navegación principal">
      {links.map((link) => (
        <a
          href={withBase(link.href)}
          class:list={[linkClass(link.href), 'transition-colors']}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <a
        href={withBase('/catalogo/?estado=Disponible%20en%20adopci%C3%B3n')}
        class="rounded-full bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700"
      >
        Adoptar
      </a>
    </nav>

    <details class="relative lg:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-200 text-slate-700"
        aria-label="Abrir menú"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </summary>
      <nav
        class="absolute right-0 mt-2 w-60 rounded-2xl border border-slate-200 bg-white p-2 shadow-xl"
        aria-label="Navegación móvil"
      >
        {links.map((link) => (
          <a
            href={withBase(link.href)}
            class:list={[
              'block rounded-lg px-3 py-2 text-sm',
              isActive(link.href)
                ? 'bg-indigo-50 font-semibold text-indigo-700'
                : 'text-slate-700 hover:bg-slate-50',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
        <a
          href={withBase('/catalogo/?estado=Disponible%20en%20adopci%C3%B3n')}
          class="mt-1 block rounded-lg bg-indigo-600 px-3 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700"
        >
          Adoptar
        </a>
      </nav>
    </details>
  </div>
</header>
