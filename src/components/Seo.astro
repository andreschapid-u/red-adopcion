---
import { absUrl } from '../lib/urls';
import { jsonLd as jsonLdString } from '../lib/utils';

interface Props {
  title: string;
  description: string;
  /** Ruta interna relativa a la base, con barra final. Ej: `/catalogo/`. */
  path: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  structuredData?: unknown[];
}

const {
  title,
  description,
  path,
  image,
  type = 'website',
  noindex = false,
  structuredData = [],
} = Astro.props;

const canonical = absUrl(path);
const absoluteImage = image || absUrl('/og-default.png');
const usingDefaultImage = !image;
const siteName = 'Red de Adopción';
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="es_CO" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:image:alt" content={`${siteName} — mascotas en adopción`} />
{usingDefaultImage && <meta property="og:image:width" content="1200" />}
{usingDefaultImage && <meta property="og:image:height" content="630" />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />

{structuredData.map((item) => (
  <script type="application/ld+json" set:html={jsonLdString(item)} />
))}
